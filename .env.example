SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Boîte à suggestions (section 11) : message WhatsApp envoyé via l'API Twilio.
# Sans TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN, les suggestions restent enregistrées
# mais aucun message n'est envoyé.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio activé pour WhatsApp, format international, SANS le préfixe
# "whatsapp:" (ajouté automatiquement). Laissez vide pour utiliser le sandbox WhatsApp
# partagé de Twilio (+14155238886) en test — le numéro qui reçoit (SUGGESTION_WHATSAPP_TO
# ci-dessous) doit alors d'abord envoyer "join <code-du-sandbox>" au numéro sandbox
# depuis WhatsApp (code visible dans la Console Twilio > Messaging > Try it out >
# Send a WhatsApp message). En production, utilisez un numéro WhatsApp Business
# approuvé à la place.
TWILIO_WHATSAPP_FROM=
# Numéro qui reçoit les suggestions. Optionnel : +221786840156 est utilisé par défaut
# si cette variable est absente.
SUGGESTION_WHATSAPP_TO=+221786840156