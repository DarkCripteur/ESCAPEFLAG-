SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Boîte à suggestions (section 11) : e-mail envoyé via l'API Resend.
# Sans clé, les suggestions restent enregistrées mais aucun e-mail n'est envoyé.
RESEND_API_KEY=
# Adresse d'expédition Resend (doit appartenir à un domaine vérifié Resend en prod ;
# "onboarding@resend.dev" fonctionne pour les tests sans domaine vérifié).
MAIL_FROM=onboarding@resend.dev
# Adresse qui reçoit les suggestions. Optionnel : fustelamio2208@gmail.com est utilisée
# par défaut si cette variable est absente.
MAIL_TO=fustelamio2208@gmail.com